{
  "name": "rpp-website",
  "version": "0.2.6",
  "private": true,
  "description": "The Rocket Pad Platforms website",
  "main": "dist/app.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "rimraf dist assets/composer",
    "tsc": "tsc",
    "typecheck": "run-s typecheck:server typecheck:client",
    "typecheck:server": "tsc --noEmit",
    "typecheck:client": "tsc --noEmit -p client/composer/tsconfig.json",
    "copy-assets": "node tools/copy-assets.mjs",
    "build:composer": "vite build",
    "build": "run-s clean tsc build:composer copy-assets",
    "start": "node dist/app.js",
    "prod:start": "run-s build start",
    "dev": "run-s tsc build:composer && run-p dev:tsc dev:composer dev:start",
    "dev:debug": "run-s tsc build:composer && run-p dev:tsc dev:composer dev:start:debug",
    "dev:tsc": "tsc --watch --preserveWatchOutput",
    "dev:composer": "vite build --watch",
    "dev:start": "APP_ROOT=. node --watch dist/app.js",
    "dev:start:debug": "APP_ROOT=. node --watch --inspect=0.0.0.0:9229 dist/app.js",
    "lint": "oxlint src tools client",
    "lint:fix": "oxlint src tools client --fix",
    "pretest": "npm run build:composer",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-handlebars": "^9.0.2",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "happy-dom": "^21.0.1",
    "js-yaml": "^5.4.3",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.88.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
