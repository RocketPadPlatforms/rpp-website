        <li><strong>{{t "home.modules.coreTitle"}}</strong> — {{t "home.modules.coreBody"}}</li>
        <li><strong>{{t "home.modules.optionalTitle"}}</strong> — {{t "home.modules.optionalBody"}}</li>
