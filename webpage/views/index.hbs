                    aria-label="{{t "home.modules.openTab"}}">↗</a> </div>
            <div class="cm-cstage" data-embed="/composer"> <img class="cm-cshot"
                    src="/assets/img/composer-preview.webp" alt="{{t "home.modules.previewAlt"}}" loading="lazy"> <button
                    type="button" class="cm-cplay"> <svg width="13"
                        height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M8 5.5v13l10.5-6.5z" fill="currentColor" stroke="none" />
                    </svg><span>{{t "home.modules.launch"}}</span> </button> </div>
        </div>
