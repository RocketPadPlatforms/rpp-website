        --}}
        <p class="cm-sub">{{t "home.modules.sub"}}</p>
    </div>
    <div class="cm-composer-wrap">
        <div class="cm-composer">
            <div class="cm-cbar"> <span class="cm-tdot r"></span><span class="cm-tdot y"></span><span
