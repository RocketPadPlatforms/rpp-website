{{!-- Copy lives in src/locales/<lang>.json under home.*. The terminal output
in the hero stays English in both languages: it imitates real CLI output. --}}
<header class="cm-hero">
    <div class="cm-planet"><span class="cm-orbit"></span><span class="cm-moon"></span></div> <span
        class="cm-eyebrow">{{t "home.hero.eyebrow"}}</span>
    <div class="cm-headline">
        <h1>{{t "home.hero.titleLine"}}<br><span class="cm-glow">{{t "home.hero.titleGlow"}}</span></h1><span class="cm-launch"
            aria-hidden="true"><span class="cm-launch-smoke"></span><span class="cm-launch-fly"><span
                    class="cm-launch-rocket"><svg width="26" height="26" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                        aria-hidden="true">
                        <path
                            d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z" />
                        <path
                            d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z" />
                        <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0" />
                        <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5" />
                    </svg></span></span></span>
    </div>
    <p class="cm-slogan">{{t "home.hero.slogan"}}</p>
    <p class="cm-lead">{{t "home.hero.lead"}}</p>
    <div class="cm-actions"> <a href="mailto:hello@rpp.gmbh" class="cm-btn solid">{{t "home.hero.ctaCall"}}</a> <a
            href="#product" class="cm-btn ghost">{{t "home.hero.ctaExplore"}}</a> </div>
    <p class="cm-footnote">{{t "home.hero.footnote"}}</p>
    <!-- ONE-COMMAND DEPLOY TERMINAL — the "prove" moment -->
    <div class="cm-term-wrap" lang="en">
        <div class="cm-term">
            <div class="cm-tbar"> <span class="cm-tdot r"></span><span class="cm-tdot y"></span><span
                    class="cm-tdot g"></span> <span class="cm-tlabel">sovereign-cluster — bash</span> </div>
            <div class="cm-tbody"> <span class="cm-tl"><span class="cm-prompt">❯</span> <span class="cm-cmd">git clone
                        github.com/rocketpadplatforms/iac-examples &amp;&amp; cd scp</span></span><span class="cm-tl"><span
                        class="cm-prompt">❯</span> <span class="cm-cmd">tofu apply
                        hetzner</span></span><span class="cm-tl out accent">→ Provisioning provider infrastructure</span><span
                    class="cm-tl out muted">→ Bootstrapping Kubernetes cluster</span><span
                    class="cm-tl out muted">→ Syncing platform modules with GitOps</span><span class="cm-tl out ok">✓
                    Cluster healthy. 12/12 modules synced and running.</span><span class="cm-tl out ok">✓ Sovereignty achieved. 🚀 →
                    https://platform.your-co.eu</span> <span class="cm-tl"><span class="cm-prompt">❯</span> <span
                        class="cm-cursor"></span></span> </div>
        </div>
    </div>
    <div class="cm-rocket"><svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z" />
            <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z" />
            <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0" />
            <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5" />
        </svg><span class="cm-trail"></span></div>
</header> <!-- OUTCOMES -->
