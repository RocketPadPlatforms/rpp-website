<!DOCTYPE html>
<html lang="{{lang}}">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{{title}}</title>
    <meta name="description" content="{{description}}">
    {{#if noindex}}
    <meta name="robots" content="noindex">
    {{/if}}
    {{#if canonical}}
    <link rel="canonical" href="{{canonical}}">
    {{/if}}
    {{#each alternates}}
    <link rel="alternate" hreflang="{{hreflang}}" href="{{href}}">
    {{/each}}

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Rocket Pad Platforms">
    <meta property="og:title" content="{{title}}">
    <meta property="og:description" content="{{description}}">
    {{#if canonical}}
    <meta property="og:url" content="{{canonical}}">
    {{/if}}
    <meta property="og:image" content="{{siteUrl}}/assets/img/og-default.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ogImageAlt}}">
    <meta property="og:locale" content="{{ogLocale}}">
    {{#each ogLocaleAlternates}}
    <meta property="og:locale:alternate" content="{{this}}">
    {{/each}}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="theme-color" content="#030712">

    <link rel="icon" href="/assets/img/favicon.ico" sizes="32x32">
    <link rel="icon" type="image/png" href="/assets/img/favicon-32.png" sizes="32x32">
    <link rel="icon" type="image/png" href="/assets/img/favicon-192.png" sizes="192x192">
    <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">

    <!-- Fonts are self-hosted: no third-party request, and nothing to disclose under GDPR. -->
    <link rel="preload" href="/assets/fonts/josefin-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/open-sans-latin.woff2" as="font" type="font/woff2" crossorigin>

    <link rel="stylesheet" href="/assets/css/cosmos.css">
    {{#if jsonLd}}
    <script type="application/ld+json">{{{jsonLd}}}</script>
    {{/if}}
</head>

<body>
    <div class="cm-root">

        <div class="cm-sky">
            <div class="cm-neb cm-neb-a"></div>
            <div class="cm-neb cm-neb-b"></div>
            <div class="cm-neb cm-neb-c"></div>
            <div class="cm-stars">
                <div class="cm-stars-far"></div>
                <div class="cm-stars-mid"></div>
                <div class="cm-stars-near"></div>
            </div>
        </div>

        <nav class="cm-nav" aria-label="{{t "nav.label"}}">
            <a href="{{homePath}}" id="cm-top" class="cm-logo" aria-label="{{t "nav.home"}}">
                <img class="cm-logo-pic" src="/assets/img/rocket-pad-platforms-logo.png" alt="" width="640" height="640">
                <span>Rocket Pad Platforms</span>
            </a>
            <div class="cm-links">
                <a href="{{homePath}}#product">{{t "nav.platform"}}</a>
                <a href="{{homePath}}#modules">{{t "nav.composer"}}</a>
                <a href="{{homePath}}#consultancy">{{t "nav.consultancy"}}</a>
                <a href="{{homePath}}#team">{{t "nav.team"}}</a>
                {{#each navHeader}}<a href="{{href}}">{{label}}</a>{{/each}}
            </div>
            <div class="cm-nav-end">
                <div class="cm-lang" role="group" aria-label="{{t "nav.language"}}">
                    {{#each languages}}
                    <a href="{{href}}" hreflang="{{lang}}" lang="{{lang}}" title="{{name}}"{{#if current}} aria-current="true"{{/if}}><span class="cm-sr">{{name}}</span><span aria-hidden="true">{{code}}</span></a>
                    {{/each}}
                </div>
                <a href="{{homePath}}#contact" class="cm-pill">{{t "nav.cta"}}</a>
                <details class="cm-mnav">
                    <summary aria-label="{{t "nav.menu"}}"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></summary>
                    <div class="cm-mpanel">
                        <a href="{{homePath}}#product">{{t "nav.platform"}}</a>
                        <a href="{{homePath}}#modules">{{t "nav.composer"}}</a>
                        <a href="{{homePath}}#consultancy">{{t "nav.consultancy"}}</a>
                        <a href="{{homePath}}#team">{{t "nav.team"}}</a>
                        {{#each navHeader}}<a href="{{href}}">{{label}}</a>{{/each}}
                        <a href="{{homePath}}#contact" class="cm-mcta">{{t "nav.cta"}}</a>
                    </div>
                </details>
            </div>
        </nav>

        <main>
            {{{body}}}
        </main>

        <footer class="cm-foot">
            <span class="cm-flogo"><span class="cm-logo-mark sm"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg></span> Rocket Pad Platforms</span>
            <span class="cm-feu">{{t "footer.madeIn"}}</span>
            <div class="cm-flinks">
                <a href="{{homePath}}#product">{{t "nav.platform"}}</a>
                <a href="{{homePath}}#modules">{{t "nav.composer"}}</a>
                <a href="{{homePath}}#consultancy">{{t "nav.consultancy"}}</a>
                <a href="{{homePath}}#team">{{t "nav.team"}}</a>
                <a href="https://docs.rpp.gmbh/docs/overview">{{t "footer.docs"}}</a>
                <a href="https://github.com/RocketPadPlatforms">GitHub</a>
                <a href="https://discord.gg/WavcZPJgCH">Discord</a>
                <a href="https://www.linkedin.com/company/rocket-pad-platforms-gmbh">LinkedIn</a>
                {{#each navFooter}}<a href="{{href}}">{{label}}</a>{{/each}}
            </div>
            <span class="cm-fcopyright">{{t "footer.copyright" year=year}}</span>
        </footer>

    </div>

    <script src="/assets/js/cosmos.js" type="module"></script>
</body>

</html>
