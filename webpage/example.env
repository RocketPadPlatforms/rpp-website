#### Server Config (all optional) ####
# Port to listen on. Default: 8080
# PORT = '8080'

# Where views/ and assets/ are read from. Defaults to the directory
# holding the compiled output, which is what the container wants. Set to '.' to
# serve them from the working tree instead - the dev scripts already do this, so
# template and stylesheet edits apply without a rebuild.
# APP_ROOT = '.'

# Public origin used for canonical links, hreflang, Open Graph, JSON-LD and
# the sitemap. Never derived from the request's Host header.
# Default: https://rocketpadplatforms.de
# SITE_URL = 'https://rocketpadplatforms.de'

# Number of proxy hops to trust for X-Forwarded-* headers, which the www
# redirect reads the requested host from. Default: 1 (the ingress).
# TRUST_PROXY = '1'

# pino log level: trace|debug|info|warn|error|fatal|silent
# Default: info in production, debug otherwise.
# LOG_LEVEL = 'info'
