{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    // TypeScript 7 removed moduleResolution "node"/"node10". node16 is the
    // supported way to describe a CommonJS package resolved by Node.
    "module": "node16",
    "moduleResolution": "node16",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // Copy lives in src/locales/*.json; tsc emits it next to the compiled code.
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
